# Kaapool Environment Configuration Example
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# For SQLite (default local):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL (production):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kaapool_db
# DB_USER=kaapool_user
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

OPENROUTESERVICE_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6IjhlMWMwOTgwODgwMzRjNDNhMzFiNzNiOWY4ZjU2MzJjIiwiaCI6Im11cm11cjY0In0=


VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=https://api-saas.veriff.com
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here

# Email Delivery Provider (brevo = active production, smtp = legacy fallback)
EMAIL_PROVIDER=brevo

# Brevo REST API Configuration (Active Production Provider)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Kaapool
BREVO_API_BASE_URL=https://api.brevo.com/v3

# Legacy SMTP Configuration (Preserved for Fallback / Local / Future use)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Kaapool <your-email@example.com>